# App
APP_NAME="Carrgo"
DEBUG=true

# Database
DATABASE_URL="sqlite+aiosqlite:///./carrgo.db"

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="dev-secret-change-in-production"

# CORS — comma-separated frontend URLs (production example below)
CORS_ORIGINS="http://localhost:3000"
# CORS_ORIGINS="https://carrgo.adityachopra.tech"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"
# GOOGLE_REDIRECT_URI="https://carrgo.adityachopra.tech/auth/callback"

# Vapi — from dashboard.vapi.ai
VAPI_API_KEY="your-private-api-key-here"
VAPI_PHONE_NUMBER_ID="your-phone-number-id-here"
VAPI_WEBHOOK_SECRET=""          # Optional: set in Vapi dashboard for signature verification

# Webhook URL — your public API URL (production example below)
WEBHOOK_BASE_URL="https://xxxx.ngrok-free.app"
# WEBHOOK_BASE_URL="https://api.carrgo.adityachopra.tech"

# Voice AI model config (defaults are fine)
VOICE_MODEL_PROVIDER="openai"
VOICE_MODEL="gpt-4o-mini"
VOICE_PROVIDER="11labs"
VOICE_ID="ljX1ZrXuDIIRVcmiVSyR"

# Outreach limits
MAX_PARALLEL_CALLS=10
DEFAULT_CALL_TIMEOUT_SECS=120