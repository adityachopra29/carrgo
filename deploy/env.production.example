# Copy to project root as .env.production and fill in secrets:
#   cp deploy/env.production.example .env.production

# ── Domains (used by deploy script messaging) ──
FRONTEND_DOMAIN=carrgo.adityachopra.tech
API_DOMAIN=api.carrgo.adityachopra.tech

# ── Backend ──
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=false
RUN_SEED=false
DATABASE_URL=sqlite+aiosqlite:///./data/carrgo.db
CORS_ORIGINS=https://carrgo.adityachopra.tech
WEBHOOK_BASE_URL=https://api.carrgo.adityachopra.tech

# Vapi (leave empty for simulation mode)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://carrgo.adityachopra.tech/auth/callback

# ── Frontend (baked in at build time) ──
NEXT_PUBLIC_API_URL=https://api.carrgo.adityachopra.tech
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://carrgo.adityachopra.tech/auth/callback
